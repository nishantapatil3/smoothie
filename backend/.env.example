# Smoothie backend configuration
# Copy this file to `.env` and adjust as needed. All vars are optional and
# fall back to the defaults shown here. Prefix for every var is SMOOTHIE_.

# ── Server ──
# SMOOTHIE_HOST="0.0.0.0"
# SMOOTHIE_PORT="5173"

# ── Transcription provider (MLX Whisper, local) ──
SMOOTHIE_TRANSCRIPTION_MODEL="mlx-community/whisper-large-v3-mlx"
# Force a language, or leave unset for auto-detect (e.g. "en")
SMOOTHIE_TRANSCRIPTION_LANGUAGE="en"

# ── Summary provider (OpenAI-compatible /chat/completions endpoint) ──
# Point this at any summarizer LLM — local or remote. Default is a local
# OpenAI-compatible server (e.g. Ollama at its /v1 port).
SMOOTHIE_SUMMARY_URL="http://localhost:11434/v1"
SMOOTHIE_SUMMARY_KEY=""
SMOOTHIE_SUMMARY_MODEL="llama3.2"

# ── Or point the summary provider at a remote endpoint instead ──
# SMOOTHIE_SUMMARY_URL="https://api.openai.com/v1"
# SMOOTHIE_SUMMARY_KEY="sk-your-key-here"
# SMOOTHIE_SUMMARY_MODEL="gpt-4o-mini"

# ── Worker ──
# Polling interval (seconds) for the background job loop.
# SMOOTHIE_JOB_POLL_INTERVAL="2.0"

# ── Pre-audio-processing (pluggable modules) ──
# ffmpeg binary path; auto-detected via shutil.which if left empty.
# SMOOTHIE_FFMPEG_BIN=""

# trim: remove silence before transcription (conservative defaults).
SMOOTHIE_TRIM_ENABLED="true"
SMOOTHIE_TRIM_THRESHOLD="-40"   # noise floor (dB) treated as silence
SMOOTHIE_TRIM_MIN_SILENCE="0.5" # minimum silent stretch (s) to cut

# tune: surface Whisper decode options. Leave unset to keep Whisper defaults.
SMOOTHIE_TUNE_ENABLED="true"
# SMOOTHIE_TUNE_BEAM_SIZE="1"                    # 1 = greedy/fast (None = greedy, like meetily)
# SMOOTHIE_TUNE_CONDITION_ON_PREVIOUS_TEXT="true"
# SMOOTHIE_TUNE_NO_SPEECH_THRESHOLD="0.6"
SMOOTHIE_TUNE_HALLUCINATION_SILENCE_THRESHOLD="2.0"  # suppress non-speech rambling

# vad: split long audio at speech pauses (like meetily) instead of fixed windows.
SMOOTHIE_VAD_ENABLED="true"
SMOOTHIE_VAD_THRESHOLD="0.5"
SMOOTHIE_VAD_MIN_SPEECH_MS="250"
SMOOTHIE_VAD_MIN_SILENCE_MS="400"
SMOOTHIE_VAD_SPEECH_PAD_MS="200"
SMOOTHIE_VAD_CHUNK_TARGET_SEC="24"
SMOOTHIE_VAD_CHUNK_MAX_SEC="30"
