# Smoothie backend configuration (config.yaml)
#
# This is the single source of truth for backend settings. Copy it to
# `config.yaml` (same directory) and adjust. The web UI Settings page edits
# these values at runtime and writes them back here.
#
# `data_dir` and `ffmpeg_bin` are configured here, not through the web UI.

# --- Server ---
host: 0.0.0.0
port: 5173

# --- Storage ---
# Directory where the sqlite db and uploaded audio live.
data_dir: data

# --- Folder ingestion ---
# Relative paths are resolved from the repository root, not the working directory.
# These directories are created automatically. Originals are never moved/deleted.
watch_dir: watch
output_dir: output
watch_enabled: true
watch_poll_interval: 2.0
# Wait for unchanged size + modification time before copying.
watch_stable_seconds: 5.0

# --- Transcription provider (whisper.cpp, local) ---
# Model name (tiny/base/small/medium/large-v3), quantized name, or local .bin file.
transcription_model: large-v3
# Use an available compiled GPU backend, falling back to CPU; or force cpu.
transcription_device: auto
# Native GPU index (used in auto mode).
transcription_gpu_device: 0
# Force a language, or empty/null for auto-detect (e.g. "en").
transcription_language: en

# --- VAD-based chunking (long audio) ---
vad_enabled: true
vad_threshold: 0.5
vad_min_speech_ms: 250
vad_min_silence_ms: 400
vad_speech_pad_ms: 200
vad_chunk_target_sec: 24
vad_chunk_max_sec: 30

# --- Summary provider ---
# api: OpenAI-compatible endpoint; codex: this machine's Codex ChatGPT login.
summary_provider: api
# For codex: blank uses the installed CLI's default model. No API key required.
summary_codex_model: ""
summary_codex_timeout: 300.0
codex_bin: ""  # auto-detected on PATH; configured here, not through the UI
codex_home: ~/.codex  # CLI manages auth.json here; never copy its contents here

# Point at any summarizer LLM — local or remote. Default is a local
# OpenAI-compatible server (e.g. Ollama at its /v1 port).
summary_url: http://localhost:11434/v1
# Optional bearer token; leave empty for local/keyless endpoints.
summary_key: ""
summary_model: llama3.2

# --- Worker ---
job_poll_interval: 2.0

# --- Pre-audio-processing (pluggable modules) ---
ffmpeg_bin: ""  # auto-detected via shutil.which if empty

# trim: remove silence before transcription (conservative defaults).
trim_enabled: false
trim_threshold: -40
trim_min_silence: 0.5

# tune: surface Whisper decode options. Empty/null = Whisper default.
tune_enabled: true
tune_beam_size: null
tune_condition_on_previous_text: null
tune_no_speech_threshold: null
